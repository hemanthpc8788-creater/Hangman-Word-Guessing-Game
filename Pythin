import random

# List of English words
words = [
    "PYTHON",
    "COMPUTER",
    "HANGMAN",
    "PROGRAM",
    "DEVELOPER",
    "KEYBOARD",
    "INTERNET",
    "SCIENCE"
]

# ASCII Hangman stages
hangman_stages = [
    """
       -----
       |   |
           |
           |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
           |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
       |   |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|   |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
      /    |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
      / \\  |
           |
    =========
    """
]


def play_hangman():

    secret_word = random.choice(words)
    guessed_letters = set()
    wrong_attempts = 0
    max_attempts = 6

    print("\nWELCOME TO HANGMAN GAME!")
    print("Guess the hidden word letter by letter.")

    while wrong_attempts < max_attempts:

        # Display hangman
        print(hangman_stages[wrong_attempts])

        # Display masked word
        display_word = ""

        for letter in secret_word:
            if letter in guessed_letters:
                display_word += letter + " "
            else:
                display_word += "_ "

        print("Word:", display_word)
        print("Guessed letters:", sorted(guessed_letters))
        print("Remaining attempts:", max_attempts - wrong_attempts)

        # Check winning condition
        if all(letter in guessed_letters for letter in secret_word):
            print("\nCONGRATULATIONS! YOU WON!")
            print("The word was:", secret_word)
            return

        guess = input("\nEnter a letter: ").strip().upper()

        # Validate input
        if len(guess) != 1 or not guess.isalpha():
            print("Please enter only one alphabet letter.")
            continue

        # Prevent duplicate guesses
        if guess in guessed_letters:
            print("You already guessed that letter!")
            continue

        guessed_letters.add(guess)

        # Check guess
        if guess in secret_word:
            print("Correct guess!")
        else:
            wrong_attempts += 1
            print("Wrong guess!")

    # Game over
    print(hangman_stages[wrong_attempts])
    print("\nGAME OVER!")
    print("The correct word was:", secret_word)


# Main program
while True:

    play_hangman()

    choice = input("\nDo you want to play again? (yes/no): ").lower()

    if choice != "yes":
        print("\nThank you for playing Hangman!")
        break
